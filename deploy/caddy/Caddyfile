# Caddy routes the three Hiroh services on one hostname.
#
# HIROH_SITE_ADDRESS decides how Caddy listens:
#   hiroh.example.com   Caddy gets a Let's Encrypt certificate itself and
#                      serves HTTPS on 443 (ports 80 and 443 must be reachable)
#   :80                plain HTTP, for when another reverse proxy or a tunnel
#                      in front of Hiroh handles HTTPS
{
	servers {
		# Proxies whose X-Forwarded-For Caddy keeps (and appends to). Caddy
		# replaces the header for everyone else, so it cannot be faked.
		# Default: none but loopback. Do not trust all private ranges: every
		# LAN client could then fake its address, and so could every internet
		# client when Docker's userland proxy makes them appear as a gateway
		# such as 172.17.0.1. Behind your own proxy or tunnel, set
		# HIROH_CADDY_TRUSTED_PROXIES to that proxy's address(es).
		trusted_proxies static {$HIROH_CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$HIROH_SITE_ADDRESS}

encode zstd gzip

# iroh relay: WebSocket connections and the probes clients use.
@relay path /relay* /ping /generate_204 /healthz
handle @relay {
	reverse_proxy relay:3340
}

# Access service: invites, device registration, health.
handle /api/* {
	reverse_proxy access:8080
}

# Everything else is the web app.
handle {
	reverse_proxy web:8080
}
