# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Where Hiroh is served -----------------------------------------------

# How Caddy listens. Pick one:
#   Your hostname, e.g. hiroh.example.com: Caddy gets a Let's Encrypt
#     certificate itself. The hostname's DNS must point at this machine and
#     ports 80 and 443 must be reachable from the internet.
#   :80: plain HTTP only. Use this when another reverse proxy or a tunnel
#     (Cloudflare Tunnel, Tailscale Funnel, Traefik, nginx) handles HTTPS in
#     front of Hiroh. Point that proxy at this machine's HIROH_HTTP_PORT.
HIROH_SITE_ADDRESS=hiroh.example.com

# The public HTTPS address people open, with a trailing slash.
HIROH_PUBLIC_URL=https://hiroh.example.com/

# Host ports Caddy publishes. Change HIROH_HTTP_PORT (e.g. to 8080) when
# HIROH_SITE_ADDRESS is :80 and something else already uses port 80.
HIROH_HTTP_PORT=80
HIROH_HTTPS_PORT=443

# --- Who may use your relay ---------------------------------------------

# One "label:token" pair per person, separated by commas. The label is a
# note for you (letters, digits, - and _). A token is 16+ characters of
# letters, digits and . _ ~ + / = -
# Generate each token with:   openssl rand -hex 24
# Give each person their token; they paste it into Hiroh's Settings.
# To revoke someone, delete their pair and run: docker compose up -d
HIROH_RELAY_TOKENS=alice:replace-with-a-long-random-token,bob:replace-with-another-long-random-token

# --- Guests and housekeeping --------------------------------------------

# Longest access a member can give a guest through an invite, in hours.
HIROH_MAX_GUEST_HOURS=168

# Devices unseen for this many hours lose relay access. Members get back in
# on their next visit; guests need a new invite.
HIROH_DORMANT_HOURS=24

# Header(s) the access service reads for the visitor's IP address, used to
# rate-limit wrong invite codes. Caddy sets X-Forwarded-For. Only add
# cf-connecting-ip if all traffic reaches Hiroh through Cloudflare.
HIROH_CLIENT_IP_HEADERS=x-forwarded-for

# Relay log level: error, warn, info, debug.
RUST_LOG=info

# --- Only for deploy/traefik/compose.yaml (an existing Traefik) ----------
# HIROH_HOST=hiroh.example.com
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure

# --- Source code link ----------------------------------------------------
# The app's footer links to its source code. Point it at your own repository
# if you run a changed version.
# HIROH_SOURCE_URL=https://github.com/Daimon-Law/hiroh
