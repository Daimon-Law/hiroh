# Hiroh web app: builds the WebAssembly module and the web bundle, then serves
# the static files with nginx. Build context: repository root.
FROM node:22-bookworm AS build
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH CI=1
RUN apt-get update && apt-get install -y --no-install-recommends clang curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.91 \
 && rustup target add wasm32-unknown-unknown \
 && cargo install wasm-bindgen-cli --version 0.2.126 --locked \
 && corepack enable
WORKDIR /src
COPY . .
RUN sh scripts/build-wasm.sh
WORKDIR /src/web
RUN pnpm install --frozen-lockfile
# Link to the source code shown in the app. Point it at your own repository
# if you run a modified version.
ARG HIROH_SOURCE_URL=https://github.com/Daimon-Law/hiroh
RUN VITE_SOURCE_URL="$HIROH_SOURCE_URL" \
    VITE_BUILD_LABEL="Build $(date -u +"%d %b %Y %H:%M") UTC" pnpm build

FROM nginxinc/nginx-unprivileged:1.27-alpine
# nginx runs as uid 101 here; make the config and site world-readable.
USER root
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/web/dist /usr/share/nginx/html
RUN chmod 644 /etc/nginx/conf.d/default.conf && chmod -R a+rX /usr/share/nginx/html
USER 101
EXPOSE 8080
